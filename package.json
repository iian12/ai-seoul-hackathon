{
  "name": "seoul-sai-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "verify:apis": "node --env-file-if-exists=.env.server.local scripts/verify-apis.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "snapshot:demo": "node --experimental-strip-types scripts/export-demo.ts",
    "snapshot:import": "node --experimental-strip-types --env-file-if-exists=.env.server.local scripts/import-snapshot.mjs",
    "data:collect": "node --env-file=.env.server.local scripts/collect-seoul.mjs",
    "data:build": "node --experimental-strip-types scripts/build-seoul-snapshot.ts",
    "data:sync": "node --env-file=.env.server.local scripts/sync-seoul.mjs",
    "data:rent": "node --env-file=.env.server.local scripts/collect-rent-partitions.mjs",
    "data:check": "node --experimental-strip-types scripts/validate-seoul-snapshot.ts",
    "walking:build": "data/walking/venv/bin/python scripts/build-walking.py",
    "walking:apply": "node --experimental-strip-types scripts/apply-walking.ts",
    "walking:test": "python3 scripts/test_walking_graph.py",
    "walking:download": "node scripts/download-walking.mjs",
    "data:point": "node scripts/build-point-data.mjs && node scripts/sync-point-enrichment.mjs",
    "places:build": "data/walking/venv/bin/python scripts/build-places.py",
    "raw:prepare": "python3 scripts/prepare-raw.py",
    "raw:verify": "python3 scripts/verify-raw.py",
    "raw:import": "node --env-file-if-exists=.env.server.local scripts/import-raw.mjs",
    "raw:test": "node --test scripts/raw-import.test.mjs",
    "serve:public": "node scripts/serve-public.mjs",
    "data:enrich": "node --env-file-if-exists=.env.server.local scripts/collect-enrichment.mjs",
    "data:rebuild": "npm run data:boundary && npm run data:enrich && npm run data:build && npm run data:check && npm run data:point-sync",
    "enrichment:test": "node --experimental-strip-types --test scripts/enrichment/*.test.ts",
    "data:boundary": "node --env-file-if-exists=.env.server.local scripts/collect-boundaries.mjs",
    "data:point-sync": "node scripts/sync-point-enrichment.mjs",
    "data:rescore": "node --experimental-strip-types scripts/rescore-snapshot.ts",
    "crime:collect": "node scripts/collect-crime.mjs",
    "crime:build": "python3 scripts/build-crime-data.py",
    "crime:apply": "node --experimental-strip-types scripts/apply-crime.ts",
    "crime:sync": "npm run crime:collect && npm run crime:build && npm run crime:apply",
    "facilities:audit": "node --experimental-strip-types scripts/audit-facilities.ts",
    "facilities:refresh": "node --env-file=.env.server.local scripts/refresh-facilities.mjs",
    "publication:test": "node --experimental-strip-types --test scripts/publish-snapshot.test.ts",
    "test:all": "npm test && npm run enrichment:test && npm run publication:test && npm run raw:test",
    "typecheck:api": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --allowImportingTsExtensions --skipLibCheck --types node api/*.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "fast-xml-parser": "^5.12.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "proj4": "^2.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stream-json": "^3.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
